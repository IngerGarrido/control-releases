# Database
DB_HOST=localhost
DB_NAME=control
DB_USER=
DB_PASS=

# Environment
APP_ENV=production
APP_DEBUG=false

# Security / CORS
# Origen permitido para CORS. En producción, fijar a URL exacta del frontend.
CORS_ORIGIN=

# URL del frontend (usada en links de correos como reset de contraseña)
FRONTEND_URL=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Cache (file|redis)
CACHE_DRIVER=file
CACHE_TTL=300
REDIS_HOST=localhost
REDIS_PORT=6379

# Email / SMTP (usado por email_worker.php)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Control

# Zona horaria (PHP y MySQL). Por defecto America/Santiago.
APP_TZ=America/Santiago
